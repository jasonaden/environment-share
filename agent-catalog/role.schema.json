{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cmux-agent-role-v1.schema.json",
  "title": "Cmux agent role catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "summary",
    "default_permission_profile",
    "instructions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
    "default_permission_profile": {"const": "read-only"},
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"}
    }
  }
}
