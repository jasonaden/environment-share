{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cmux-agent-team-profile-v1.schema.json",
  "title": "Cmux agent team catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "coordination",
    "workers",
    "synthesis"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
    "coordination": {"const": "hub-and-spoke"},
    "workers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "harness", "role", "assignment"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
          "harness": {"enum": ["codex", "claude", "pi"]},
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "assignment": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"}
        }
      }
    },
    "synthesis": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"}
  }
}
