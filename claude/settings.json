{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch",
      "Skill(*)",
      "Task(*)",
      "TodoWrite(*)"
    ],
    "deny": [],
    "defaultMode": "default"
  },
  "model": "us.anthropic.claude-opus-4-6-v1",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "teammateMode": "tmux"
}
