{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cmux-agent-result-v1.schema.json",
  "title": "Cmux worker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings", "changed_files", "checks", "risks"],
  "properties": {
    "status": {"enum": ["completed", "blocked", "failed"]},
    "summary": {"type": "string", "maxLength": 20000},
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "evidence", "impact"],
        "properties": {
          "title": {"type": "string", "maxLength": 20000},
          "evidence": {"type": "string", "maxLength": 20000},
          "impact": {"type": "string", "maxLength": 20000}
        }
      }
    },
    "changed_files": {"type": "array", "items": {"type": "string", "maxLength": 20000}, "maxItems": 0},
    "checks": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 20000}},
    "risks": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 20000}}
  }
}
