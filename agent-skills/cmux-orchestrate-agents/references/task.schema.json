{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cmux-agent-task-v1.schema.json",
  "title": "Cmux fleet task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "instructions", "acceptance_criteria"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]*$"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]*$"
      }
    }
  }
}
