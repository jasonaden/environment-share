# Global task runner
# Usage: j <recipe> (works from anywhere under ~)

set dotenv-load := false

# List available recipes
default:
    @just --list

# ── Claude Code ───────────────────────────────────────

# CC: start claude code (accept edits mode)
cc *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits {{args}}

# CC: start with dangerous mode (skip all permissions)
ccd *args:
    cd "{{invocation_directory()}}" && claude --dangerously-skip-permissions {{args}}

# CC: start with worktree (isolated git branch)
ccw name="" *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --worktree {{ if name != "" { name } else { "" } }} {{args}}

# CC: start with worktree + dangerous mode
ccwd name="" *args:
    cd "{{invocation_directory()}}" && claude --dangerously-skip-permissions --worktree {{ if name != "" { name } else { "" } }} {{args}}

# CC: start with worktree + tmux pane
ccwt name="" *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --worktree {{ if name != "" { name } else { "" } }} --tmux {{args}}

# CC: continue last session
ccc *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --continue {{args}}

# CC: resume a session (interactive picker)
ccr session="" *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --resume {{ if session != "" { session } else { "" } }} {{args}}

# CC: one-shot print mode (pipe friendly)
ccp *args:
    cd "{{invocation_directory()}}" && claude --permission-mode plan --print {{args}}

# CC: one-shot print mode with dangerous permission bypass (explicit opt-in)
ccpd *args:
    cd "{{invocation_directory()}}" && claude --dangerously-skip-permissions --print {{args}}

# CC: start with specific model
ccm model *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --model {{model}} {{args}}

# CC: start with model + worktree
ccmw model name="" *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --model {{model}} --worktree {{ if name != "" { name } else { "" } }} {{args}}

# CC: plan mode (no edits)
ccplan *args:
    cd "{{invocation_directory()}}" && claude --permission-mode plan {{args}}

# CC: passthrough any claude command
claude-raw *args:
    cd "{{invocation_directory()}}" && claude {{args}}

# ── Codex ────────────────────────────────────────────

# Codex: start in the current directory
cx *args:
    cd "{{invocation_directory()}}" && codex {{args}}

# Codex: resume a session (interactive picker)
cxr *args:
    cd "{{invocation_directory()}}" && codex resume {{args}}

# Codex: continue the most recent session
cxc *args:
    cd "{{invocation_directory()}}" && codex resume --last {{args}}

# Codex: run a non-interactive task
cxe *args:
    cd "{{invocation_directory()}}" && codex exec {{args}}

# Codex: passthrough any command
codex-raw *args:
    cd "{{invocation_directory()}}" && codex {{args}}

# ── Pi Coding Agent ──────────────────────────────────────────────

# Pi: normal interactive session with global safety/workflow extensions
pi *args:
    cd "{{invocation_directory()}}" && pi {{args}}

# Pi: continue or select a previous session
pi-continue *args:
    cd "{{invocation_directory()}}" && pi --continue {{args}}

pi-resume *args:
    cd "{{invocation_directory()}}" && pi --resume {{args}}

# Pi: read-only, no Bash, ephemeral review profile (Dan's level 5 pattern)
pi-review *args:
    cd "{{invocation_directory()}}" && CMUX_AGENT_REPOSITORY="{{invocation_directory()}}" pi --tools read,grep,ls --no-session --no-approve --no-extensions --extension "${PI_SHARED_SKILLS_DIR:-$HOME/.claude/skills}/cmux-orchestrate-agents/scripts/pi-repository-guard.ts" --no-skills --no-prompt-templates --no-themes --no-context-files {{args}}

# Pi: read-only planning first, then explicit opt-in to execution (level 4 allowlist)
pi-plan *args:
    cd "{{invocation_directory()}}" && pi --plan {{args}}

# Pi: declare and display a singular purpose for the session
pi-focus *args:
    cd "{{invocation_directory()}}" && pi -e "$HOME/.pi/agent/optional-extensions/purpose-gate.ts" {{args}}

# Pi: isolated subagents plus the guarded /ship workflow, opt-in only
pi-team *args:
    cd "{{invocation_directory()}}" && pi -e "$HOME/.pi/agent/optional-extensions/subagent/index.ts" -e "$HOME/.pi/agent/optional-extensions/ship-workflow.ts" {{args}}

# Pi: core-only diagnostic profile with no custom resources or project context
pi-clean *args:
    cd "{{invocation_directory()}}" && pi --no-extensions --no-skills --no-prompt-templates --no-themes --no-context-files --no-approve {{args}}
