# Global task runner
# Usage: j <recipe> (works from anywhere under ~)

set dotenv-load := false

# List available recipes
default:
    @just --list

# ── Claude Code ───────────────────────────────────────

# CC: start claude code (accept edits mode)
cc *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits {{args}}

# CC: start with dangerous mode (skip all permissions)
ccd *args:
    cd "{{invocation_directory()}}" && claude --dangerously-skip-permissions {{args}}

# CC: start with worktree (isolated git branch)
ccw name="" *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --worktree {{ if name != "" { name } else { "" } }} {{args}}

# CC: start with worktree + dangerous mode
ccwd name="" *args:
    cd "{{invocation_directory()}}" && claude --dangerously-skip-permissions --worktree {{ if name != "" { name } else { "" } }} {{args}}

# CC: start with worktree + tmux pane
ccwt name="" *args:
    cd "{{invocation_directory()}}" && claude --dangerously-skip-permissions --worktree {{ if name != "" { name } else { "" } }} --tmux {{args}}

# CC: continue last session
ccc *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --continue {{args}}

# CC: resume a session (interactive picker)
ccr session="" *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --resume {{ if session != "" { session } else { "" } }} {{args}}

# CC: one-shot print mode (pipe friendly)
ccp *args:
    cd "{{invocation_directory()}}" && claude --dangerously-skip-permissions --print {{args}}

# CC: start with specific model
ccm model *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --model {{model}} {{args}}

# CC: start with model + worktree
ccmw model name="" *args:
    cd "{{invocation_directory()}}" && claude --permission-mode acceptEdits --model {{model}} --worktree {{ if name != "" { name } else { "" } }} {{args}}

# CC: plan mode (no edits)
ccplan *args:
    cd "{{invocation_directory()}}" && claude --permission-mode plan {{args}}

# CC: passthrough any claude command
claude-raw *args:
    cd "{{invocation_directory()}}" && claude {{args}}
