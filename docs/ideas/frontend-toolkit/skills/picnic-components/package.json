{
  "name": "picnic-skills-generator",
  "version": "1.0.0",
  "description": "Pipeline scripts for generating and maintaining Picnic component skill files from source code",
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract.mjs --source \"$(git rev-parse --show-toplevel)/libs/picnic\"",
    "format": "node scripts/format.mjs",
    "detect": "node scripts/detect-changes.mjs --source \"$(git rev-parse --show-toplevel)\"",
    "context": "node scripts/assemble-context.mjs --source \"$(git rev-parse --show-toplevel)/libs/picnic\"",
    "init-state": "node scripts/detect-changes.mjs --source \"$(git rev-parse --show-toplevel)\" --init"
  },
  "dependencies": {
    "@babel/parser": "^7.x",
    "@babel/traverse": "^7.x"
  }
}
