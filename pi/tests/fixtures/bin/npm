#!/usr/bin/env bash
set -euo pipefail

prefix=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = "--prefix" ]; then
    prefix="$2"
    shift 2
    continue
  fi
  shift
done

[ -n "$prefix" ] || { echo "fixture npm requires --prefix" >&2; exit 1; }
package="$prefix/lib/node_modules/@earendil-works/pi-coding-agent"
examples="$package/examples/extensions"
mkdir -p "$examples/plan-mode" "$examples/subagent" "$prefix/bin"
printf '{"version":"0.80.6"}\n' >"$package/package.json"
for file in permission-gate.ts protected-paths.ts handoff.ts; do
  printf 'export default {};\n' >"$examples/$file"
done
for file in index.ts utils.ts; do
  printf 'export default {};\n' >"$examples/plan-mode/$file"
done
for file in index.ts agents.ts; do
  printf 'export default {};\n' >"$examples/subagent/$file"
done
cat >"$prefix/bin/pi" <<'EOF'
#!/usr/bin/env bash
echo "0.80.6"
EOF
chmod +x "$prefix/bin/pi"
